			"    #define right(x) nodes[x].ch[1]",
			"    #define siz(x) nodes[x].siz",
			"    #define val(x) nodes[x].val",
			"    ",
			"    LCT(int _n = 0) : nodes(_n + 5) { ",
			"        for(int i = 1; i <= _n; i++){",
			"            par(i) = left(i) = right(i) = 0;",
			"            siz(i) = val(i) = 1;",
			"        }",
			"    }",
			"",
			"    LCT(int _n, vector < T > &v) : nodes(_n + 5) {",
			"        for(int i = 1; i <= _n; i++){",

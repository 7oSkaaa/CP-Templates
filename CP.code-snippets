			"        return ans;",
			"    }",
			"",
			"    T query(int l, int r) const {",
			"        if (l > r) return DEFAULT;",
			"        return inv_op(prefix(r), l ? prefix(l - 1) : DEFAULT);",
			"    }",
			"",
			"    T get(int idx) const {",
			"        return query(idx, idx);",
			"    }",
			"",
			"    int size() const { return n; }",

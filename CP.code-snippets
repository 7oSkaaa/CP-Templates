			"",
			"    // Push lazy value to children",
			"    void propagate(int idx, int lx, int rx) {",
			"        if (!tree[idx].is_lazy) return;",
			"        tree[idx].val = lazy_operation(tree[idx].val, (rx - lx + 1) * tree[idx].update);",
			"        if (lx != rx) {",

			"private:",
			"    inline static constexpr int charSize() {",
			"        switch (Mode) {",
			"            case TrieMode::Lowercase: return 26;",
			"            case TrieMode::Uppercase: return 26;",
			"            case TrieMode::Digits:    return 10;",

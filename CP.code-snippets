			"template < typename T = int > vector < T > nextGreaterelement(vector < T >& nums) {",
			"        int n = nums.size();",
			"        vector < T > res(n);",
			"        stack < int > st;",
			"        for(int i = n - 1; i >= 0; i--){",
			"            while(!st.empty() && nums[st.top()] <= nums[i]) st.pop();",
			"            res[i] = (st.empty() ? n : st.top());",
			"            st.push(i);",
			"        }",
			"        return res;",
			"    }"

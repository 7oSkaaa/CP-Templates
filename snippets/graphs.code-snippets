			" *   query(int u, int v)     → treeType, aggregate edge weights on path u→v",
			" *   kth_ancestor(int u, int k) → int",
			" *",
			" * Example:",
			" *   // Max edge weight on path",
			" *   LCA<int, int> lca(n, adj,",
